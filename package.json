{
  "name": "desktop-booker",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "cargo test -p booker-core --features ts export_bindings",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c demo/playwright.config.ts --project=screenshots",
    "videos": "playwright test -c demo/playwright.config.ts --project=videos"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/svelte": "0.1.0-beta.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
