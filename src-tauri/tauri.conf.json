{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopBooker",
  "version": "0.1.0",
  "identifier": "com.desktopbooker.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DesktopBooker",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "DesktopBooker",
    "category": "Business",
    "shortDescription": "Offline booking for a small hotel",
    "longDescription": "Rooms, function suites, events, invoices, housekeeping and reports for a small family-run hotel. Runs on one computer with no hosting; data stays on the hotel's own machine with daily backups.",
    "copyright": "© 2026 Andy Lumsden"
  }
}
